digraph G {
graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.42", ranksep="0.85", splines=polyline, outputorder=edgesfirst]; node [fontname="Helvetica", fontsize=13, color="#CAD5DF", fontcolor="#203348"]; edge [fontname="Helvetica", fontsize=10, color="#8B99A8", fontcolor="#46566A", arrowsize=0.7];
clinical_custom_fields [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>clinical_custom_fields</B></TD></TR><TR><TD ALIGN="LEFT">PK custom_field_id</TD></TR><TR><TD ALIGN="LEFT">FK created_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">context_type, field_key, label</TD></TR><TR><TD ALIGN="LEFT">field_type, options JSON</TD></TR><TR><TD ALIGN="LEFT">validation_rules JSON, is_required</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
clinical_custom_field_values [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>clinical_custom_field_values</B></TD></TR><TR><TD ALIGN="LEFT">PK custom_value_id</TD></TR><TR><TD ALIGN="LEFT">FK custom_field_id -&gt; clinical_custom_fields</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK prescription_id -&gt; prescriptions</TD></TR><TR><TD ALIGN="LEFT">FK lab_order_id -&gt; lab_orders</TD></TR><TR><TD ALIGN="LEFT">FK allergy_id -&gt; allergies</TD></TR><TR><TD ALIGN="LEFT">FK immunization_id -&gt; immunizations</TD></TR><TR><TD ALIGN="LEFT">FK follow_up_id -&gt; follow_ups</TD></TR><TR><TD ALIGN="LEFT">FK recorded_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">value_json JSON, version</TD></TR><TR><TD ALIGN="LEFT">CHECK: exactly one clinical owner</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
clinical_custom_field_value_history [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>clinical_custom_field_value_history</B></TD></TR><TR><TD ALIGN="LEFT">PK history_id</TD></TR><TR><TD ALIGN="LEFT">FK custom_value_id -&gt; clinical_custom_field_values</TD></TR><TR><TD ALIGN="LEFT">FK changed_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">version, value_json JSON, changed_at</TD></TR></TABLE>>];
users [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>users (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id -&gt; roles</TD></TR></TABLE>>];
users -> clinical_custom_fields [label="created_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
clinical_custom_fields -> clinical_custom_field_values [label="custom_field_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> clinical_custom_field_values [label="recorded_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
clinical_custom_field_values -> clinical_custom_field_value_history [label="custom_value_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> clinical_custom_field_value_history [label="changed_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
}