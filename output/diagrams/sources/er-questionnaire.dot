digraph G {
graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.42", ranksep="0.85", splines=polyline, outputorder=edgesfirst]; node [fontname="Helvetica", fontsize=13, color="#CAD5DF", fontcolor="#203348"]; edge [fontname="Helvetica", fontsize=10, color="#8B99A8", fontcolor="#46566A", arrowsize=0.7];
custom_forms [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>custom_forms</B></TD></TR><TR><TD ALIGN="LEFT">PK form_id</TD></TR><TR><TD ALIGN="LEFT">FK created_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">form_key + version [unique]</TD></TR><TR><TD ALIGN="LEFT">status: draft / active / retired</TD></TR></TABLE>>];
custom_form_fields [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>custom_form_fields</B></TD></TR><TR><TD ALIGN="LEFT">PK form_field_id</TD></TR><TR><TD ALIGN="LEFT">FK form_id -&gt; custom_forms</TD></TR><TR><TD ALIGN="LEFT">field_key, label, field_type</TD></TR><TR><TD ALIGN="LEFT">options JSON, validation_rules JSON</TD></TR></TABLE>>];
custom_form_responses [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>custom_form_responses</B></TD></TR><TR><TD ALIGN="LEFT">PK response_id</TD></TR><TR><TD ALIGN="LEFT">FK form_id -&gt; custom_forms</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK recorded_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">answers JSON object</TD></TR><TR><TD ALIGN="LEFT">extra_fields JSON array, version</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
custom_form_response_history [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#EFE9FB"><B>custom_form_response_history</B></TD></TR><TR><TD ALIGN="LEFT">PK history_id</TD></TR><TR><TD ALIGN="LEFT">FK response_id -&gt; custom_form_responses</TD></TR><TR><TD ALIGN="LEFT">FK changed_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">answers JSON, version, changed_at</TD></TR></TABLE>>];
visits [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>visits (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK visit_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id -&gt; appointments</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">visit_started_at, chief_complaint</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
users [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>users (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id -&gt; roles</TD></TR></TABLE>>];
users -> custom_forms [label="created_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
custom_forms -> custom_form_fields [label="form_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
custom_forms -> custom_form_responses [label="form_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
visits -> custom_form_responses [label="visit_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> custom_form_responses [label="recorded_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
custom_form_responses -> custom_form_response_history [label="response_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> custom_form_response_history [label="changed_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
}