digraph G {
graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.42", ranksep="0.85", splines=polyline, outputorder=edgesfirst]; node [fontname="Helvetica", fontsize=13, color="#CAD5DF", fontcolor="#203348"]; edge [fontname="Helvetica", fontsize=10, color="#8B99A8", fontcolor="#46566A", arrowsize=0.7];
patients [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>patients</B></TD></TR><TR><TD ALIGN="LEFT">PK patient_id</TD></TR><TR><TD ALIGN="LEFT">medical_record_number [unique]</TD></TR><TR><TD ALIGN="LEFT">name, date_of_birth, consent</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
guardians [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>guardians</B></TD></TR><TR><TD ALIGN="LEFT">PK guardian_id</TD></TR></TABLE>>];
patient_guardians [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>patient_guardians</B></TD></TR><TR><TD ALIGN="LEFT">PK patient_id + guardian_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK guardian_id -&gt; guardians</TD></TR></TABLE>>];
patient_identifiers [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>patient_identifiers</B></TD></TR><TR><TD ALIGN="LEFT">PK patient_identifier_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
insurance_coverages [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>insurance_coverages</B></TD></TR><TR><TD ALIGN="LEFT">PK coverage_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
allergies [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>allergies</B></TD></TR><TR><TD ALIGN="LEFT">PK allergy_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
immunizations [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E4F3ED"><B>immunizations</B></TD></TR><TR><TD ALIGN="LEFT">PK immunization_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK administered_by -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
doctors [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>doctors (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK doctor_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id -&gt; users</TD></TR><TR><TD ALIGN="LEFT">FK department_id -&gt; departments</TD></TR></TABLE>>];
users [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>users (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id -&gt; roles</TD></TR></TABLE>>];
patients -> patient_guardians [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
guardians -> patient_guardians [label="guardian_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
patients -> patient_identifiers [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
patients -> insurance_coverages [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
patients -> allergies [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
patients -> immunizations [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
doctors -> immunizations [label="administered_by", taillabel="0..1", headlabel="0..N", labeldistance=1.7];
}