digraph G {
graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.42", ranksep="0.85", splines=polyline, outputorder=edgesfirst]; node [fontname="Helvetica", fontsize=13, color="#CAD5DF", fontcolor="#203348"]; edge [fontname="Helvetica", fontsize=10, color="#8B99A8", fontcolor="#46566A", arrowsize=0.7];
prescriptions [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>prescriptions</B></TD></TR><TR><TD ALIGN="LEFT">PK prescription_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
prescription_items [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>prescription_items</B></TD></TR><TR><TD ALIGN="LEFT">PK prescription_item_id</TD></TR><TR><TD ALIGN="LEFT">FK prescription_id -&gt; prescriptions</TD></TR><TR><TD ALIGN="LEFT">FK medication_id -&gt; medications</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
medications [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>medications</B></TD></TR><TR><TD ALIGN="LEFT">PK medication_id</TD></TR></TABLE>>];
lab_orders [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>lab_orders</B></TD></TR><TR><TD ALIGN="LEFT">PK lab_order_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK lab_test_id -&gt; lab_tests</TD></TR><TR><TD ALIGN="LEFT">FK ordered_by -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
lab_tests [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>lab_tests</B></TD></TR><TR><TD ALIGN="LEFT">PK lab_test_id</TD></TR></TABLE>>];
lab_results [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>lab_results</B></TD></TR><TR><TD ALIGN="LEFT">PK lab_result_id</TD></TR><TR><TD ALIGN="LEFT">FK lab_order_id -&gt; lab_orders</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
follow_ups [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>follow_ups</B></TD></TR><TR><TD ALIGN="LEFT">PK follow_up_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id -&gt; appointments</TD></TR><TR><TD ALIGN="LEFT">FK assigned_doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">FK assigned_user_id -&gt; users</TD></TR><TR><TD ALIGN="LEFT">due_date, priority, status</TD></TR><TR><TD ALIGN="LEFT">next_action, outcome</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
follow_up_notes [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#FFF1DB"><B>follow_up_notes</B></TD></TR><TR><TD ALIGN="LEFT">PK follow_up_note_id</TD></TR><TR><TD ALIGN="LEFT">FK follow_up_id -&gt; follow_ups</TD></TR><TR><TD ALIGN="LEFT">FK author_user_id -&gt; users</TD></TR><TR><TD ALIGN="LEFT">note_type, note_text, created_at</TD></TR></TABLE>>];
visits [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>visits (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK visit_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id -&gt; appointments</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">visit_started_at, chief_complaint</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
patients [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>patients (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK patient_id</TD></TR><TR><TD ALIGN="LEFT">medical_record_number [unique]</TD></TR><TR><TD ALIGN="LEFT">name, date_of_birth, consent</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
doctors [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>doctors (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK doctor_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id -&gt; users</TD></TR><TR><TD ALIGN="LEFT">FK department_id -&gt; departments</TD></TR></TABLE>>];
appointments [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>appointments (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK appointment_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">FK created_by -&gt; users</TD></TR></TABLE>>];
users [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>users (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id -&gt; roles</TD></TR></TABLE>>];
visits -> prescriptions [label="visit_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
patients -> prescriptions [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
doctors -> prescriptions [label="doctor_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
prescriptions -> prescription_items [label="prescription_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
medications -> prescription_items [label="medication_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
visits -> lab_orders [label="visit_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
lab_tests -> lab_orders [label="lab_test_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
doctors -> lab_orders [label="ordered_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
lab_orders -> lab_results [label="lab_order_id", taillabel="1", headlabel="0..1", labeldistance=1.7];
visits -> follow_ups [label="visit_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
appointments -> follow_ups [label="appointment_id", taillabel="0..1", headlabel="0..N", labeldistance=1.7];
doctors -> follow_ups [label="assigned_doctor_id", taillabel="0..1", headlabel="0..N", labeldistance=1.7];
users -> follow_ups [label="assigned_user_id", taillabel="0..1", headlabel="0..N", labeldistance=1.7];
follow_ups -> follow_up_notes [label="follow_up_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> follow_up_notes [label="author_user_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
}