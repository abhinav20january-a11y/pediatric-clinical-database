digraph G {
graph [bgcolor="transparent", rankdir=LR, pad="0.25", nodesep="0.42", ranksep="0.85", splines=polyline, outputorder=edgesfirst]; node [fontname="Helvetica", fontsize=13, color="#CAD5DF", fontcolor="#203348"]; edge [fontname="Helvetica", fontsize=10, color="#8B99A8", fontcolor="#46566A", arrowsize=0.7];
appointments [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>appointments</B></TD></TR><TR><TD ALIGN="LEFT">PK appointment_id</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">FK created_by -&gt; users</TD></TR></TABLE>>];
visits [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>visits</B></TD></TR><TR><TD ALIGN="LEFT">PK visit_id</TD></TR><TR><TD ALIGN="LEFT">FK appointment_id -&gt; appointments</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">FK doctor_id -&gt; doctors</TD></TR><TR><TD ALIGN="LEFT">visit_started_at, chief_complaint</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
medical_records [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>medical_records</B></TD></TR><TR><TD ALIGN="LEFT">PK medical_record_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK recorded_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">history, examination, clinical_notes</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
diagnoses [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>diagnoses</B></TD></TR><TR><TD ALIGN="LEFT">PK diagnosis_id</TD></TR><TR><TD ALIGN="LEFT">FK medical_record_id -&gt; medical_records</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
treatments [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>treatments</B></TD></TR><TR><TD ALIGN="LEFT">PK treatment_id</TD></TR><TR><TD ALIGN="LEFT">FK medical_record_id -&gt; medical_records</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
vital_signs [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>vital_signs</B></TD></TR><TR><TD ALIGN="LEFT">PK vital_sign_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK measured_by -&gt; users</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
growth_records [shape=plain, label=<<TABLE BORDER="1" COLOR="#CCD6E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#E8F1FA"><B>growth_records</B></TD></TR><TR><TD ALIGN="LEFT">PK growth_record_id</TD></TR><TR><TD ALIGN="LEFT">FK visit_id -&gt; visits</TD></TR><TR><TD ALIGN="LEFT">FK patient_id -&gt; patients</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
patients [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>patients (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK patient_id</TD></TR><TR><TD ALIGN="LEFT">medical_record_number [unique]</TD></TR><TR><TD ALIGN="LEFT">name, date_of_birth, consent</TD></TR><TR><TD ALIGN="LEFT">deleted_by -&gt; users; soft-delete fields</TD></TR></TABLE>>];
doctors [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>doctors (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK doctor_id</TD></TR><TR><TD ALIGN="LEFT">FK user_id -&gt; users</TD></TR><TR><TD ALIGN="LEFT">FK department_id -&gt; departments</TD></TR></TABLE>>];
users [shape=plain, label=<<TABLE BORDER="1" COLOR="#A5ADB8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#F0F2F5"><B>users (reference)</B></TD></TR><TR><TD ALIGN="LEFT">PK user_id</TD></TR><TR><TD ALIGN="LEFT">FK role_id -&gt; roles</TD></TR></TABLE>>];
patients -> appointments [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
doctors -> appointments [label="doctor_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> appointments [label="created_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
appointments -> visits [label="appointment_id", taillabel="0..1", headlabel="0..1", labeldistance=1.7];
patients -> visits [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
doctors -> visits [label="doctor_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
visits -> medical_records [label="visit_id", taillabel="1", headlabel="0..1", labeldistance=1.7];
users -> medical_records [label="recorded_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
medical_records -> diagnoses [label="medical_record_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
medical_records -> treatments [label="medical_record_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
visits -> vital_signs [label="visit_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
users -> vital_signs [label="measured_by", taillabel="1", headlabel="0..N", labeldistance=1.7];
visits -> growth_records [label="visit_id", taillabel="1", headlabel="0..1", labeldistance=1.7];
patients -> growth_records [label="patient_id", taillabel="1", headlabel="0..N", labeldistance=1.7];
}