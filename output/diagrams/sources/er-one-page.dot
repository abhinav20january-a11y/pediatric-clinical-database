digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.20", ranksep="0.55", splines=ortho, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=10, fontcolor="#203348"];
edge [color="#8B99A8", penwidth=0.8, arrowsize=0.55];
subgraph cluster_0 { label="Access and staff"; color="#CCD6E0"; style="rounded"; fontname="Helvetica-Bold"; fontsize=13; fontcolor="#183B4D";
roles [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>roles</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK role_id</FONT></TD></TR></TABLE>>];
permissions [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>permissions</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK permission_id</FONT></TD></TR></TABLE>>];
role_permissions [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>role_permissions</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK role_id + permission_id</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>users</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK user_id</FONT></TD></TR></TABLE>>];
departments [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>departments</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK department_id</FONT></TD></TR></TABLE>>];
doctors [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>doctors</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK doctor_id</FONT></TD></TR></TABLE>>];
audit_logs [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EAF0FC"><B>audit_logs</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK audit_log_id</FONT></TD></TR></TABLE>>];
}
subgraph cluster_1 { label="Patient identity"; color="#CCD6E0"; style="rounded"; fontname="Helvetica-Bold"; fontsize=13; fontcolor="#183B4D";
patients [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>patients</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK patient_id</FONT></TD></TR></TABLE>>];
guardians [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>guardians</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK guardian_id</FONT></TD></TR></TABLE>>];
patient_guardians [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>patient_guardians</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK patient_id + guardian_id</FONT></TD></TR></TABLE>>];
patient_identifiers [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>patient_identifiers</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK patient_identifier_id</FONT></TD></TR></TABLE>>];
insurance_coverages [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>insurance_coverages</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK coverage_id</FONT></TD></TR></TABLE>>];
allergies [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>allergies</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK allergy_id</FONT></TD></TR></TABLE>>];
immunizations [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E4F3ED"><B>immunizations</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK immunization_id</FONT></TD></TR></TABLE>>];
}
subgraph cluster_2 { label="Encounter"; color="#CCD6E0"; style="rounded"; fontname="Helvetica-Bold"; fontsize=13; fontcolor="#183B4D";
appointments [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>appointments</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK appointment_id</FONT></TD></TR></TABLE>>];
visits [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>visits</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK visit_id</FONT></TD></TR></TABLE>>];
medical_records [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>medical_records</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK medical_record_id</FONT></TD></TR></TABLE>>];
diagnoses [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>diagnoses</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK diagnosis_id</FONT></TD></TR></TABLE>>];
treatments [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>treatments</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK treatment_id</FONT></TD></TR></TABLE>>];
vital_signs [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>vital_signs</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK vital_sign_id</FONT></TD></TR></TABLE>>];
growth_records [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F1FA"><B>growth_records</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK growth_record_id</FONT></TD></TR></TABLE>>];
}
subgraph cluster_3 { label="Care delivery"; color="#CCD6E0"; style="rounded"; fontname="Helvetica-Bold"; fontsize=13; fontcolor="#183B4D";
medications [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>medications</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK medication_id</FONT></TD></TR></TABLE>>];
prescriptions [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>prescriptions</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK prescription_id</FONT></TD></TR></TABLE>>];
prescription_items [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>prescription_items</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK prescription_item_id</FONT></TD></TR></TABLE>>];
lab_tests [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>lab_tests</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK lab_test_id</FONT></TD></TR></TABLE>>];
lab_orders [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>lab_orders</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK lab_order_id</FONT></TD></TR></TABLE>>];
lab_results [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>lab_results</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK lab_result_id</FONT></TD></TR></TABLE>>];
follow_ups [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>follow_ups</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK follow_up_id</FONT></TD></TR></TABLE>>];
follow_up_notes [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF1DB"><B>follow_up_notes</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK follow_up_note_id</FONT></TD></TR></TABLE>>];
}
subgraph cluster_4 { label="Dynamic data"; color="#CCD6E0"; style="rounded"; fontname="Helvetica-Bold"; fontsize=13; fontcolor="#183B4D";
clinical_custom_fields [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>clinical_custom_fields</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK custom_field_id</FONT></TD></TR></TABLE>>];
clinical_custom_field_values [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>clinical_custom_field_values</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK custom_value_id</FONT></TD></TR></TABLE>>];
clinical_custom_field_value_history [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>clinical_custom_field_value_history</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK history_id</FONT></TD></TR></TABLE>>];
custom_forms [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>custom_forms</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK form_id</FONT></TD></TR></TABLE>>];
custom_form_fields [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>custom_form_fields</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK form_field_id</FONT></TD></TR></TABLE>>];
custom_form_responses [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>custom_form_responses</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK response_id</FONT></TD></TR></TABLE>>];
custom_form_response_history [label=<<TABLE BORDER="1" COLOR="#B8C5D1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFE9FB"><B>custom_form_response_history</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PK history_id</FONT></TD></TR></TABLE>>];
}
roles -> role_permissions;
permissions -> role_permissions;
roles -> users;
users -> doctors;
departments -> doctors;
users -> audit_logs;
patients -> patient_guardians;
guardians -> patient_guardians;
patients -> patient_identifiers;
patients -> insurance_coverages;
patients -> allergies;
patients -> immunizations;
patients -> appointments;
doctors -> appointments;
patients -> visits;
doctors -> visits;
appointments -> visits;
visits -> medical_records;
medical_records -> diagnoses;
medical_records -> treatments;
visits -> vital_signs;
visits -> growth_records;
visits -> prescriptions;
patients -> prescriptions;
doctors -> prescriptions;
prescriptions -> prescription_items;
medications -> prescription_items;
visits -> lab_orders;
lab_tests -> lab_orders;
lab_orders -> lab_results;
visits -> follow_ups;
follow_ups -> follow_up_notes;
clinical_custom_fields -> clinical_custom_field_values;
clinical_custom_field_values -> clinical_custom_field_value_history;
custom_forms -> custom_form_fields;
custom_forms -> custom_form_responses;
visits -> custom_form_responses;
custom_form_responses -> custom_form_response_history;
}